{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "allowJs": false,
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "stripInternal": true,
    "sourceMap": true,
    "pretty": true,
    "importHelpers": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "preserveWatchOutput": true,
    "useUnknownInCatchVariables": false,
    "noFallthroughCasesInSwitch": false,
    "noUnusedParameters": false,
    "noUnusedLocals": false
  },
  "exclude": [
    "node_modules",
    "dist",
    ".yarn",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/test/**",
    "**/__tests__/**"
  ],
  "include": [],
  "references": [
    { "path": "packages/pg-core" },
    { "path": "packages/pg-adapter-node-postgres" },
    { "path": "packages/pg-adapter-postgres-js" },
    { "path": "packages/pg-adapter-pglite" }
  ]
}
