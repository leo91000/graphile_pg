{
  "private": true,
  "name": "@graphile/pg",
  "version": "0.0.0",
  "description": "PostgreSQL adapter system for Graphile tools - monorepo root",
  "packageManager": "yarn@4.9.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "yarn workspaces foreach --all --topological run build",
    "clean": "rm -rf packages/*/dist packages/*/tsconfig.tsbuildinfo",
    "prepack:all": "yarn workspaces foreach --all --topological run prepack",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "typecheck": "yarn workspaces foreach --all --topological run tsc --noEmit",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx packages/",
    "prettier": "prettier --cache --ignore-path .gitignore",
    "prettier:all": "yarn prettier '**/*.{json,md,mdx,html,js,jsx,ts,tsx,yml}'",
    "prettier:fix": "yarn prettier:all --write",
    "prettier:check": "yarn prettier:all --list-different"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@types/pg-cursor": "^2.7.2",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.31.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18",
    "yarn": ">=1.3.2"
  }
}
