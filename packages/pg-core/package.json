{
  "name": "@graphile/pg-core",
  "version": "0.1.0",
  "description": "Core PostgreSQL adapter interfaces and utilities for Graphile tools",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format cjs,esm",
    "prepack": "npm run build",
    "test": "echo \"No tests yet\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leo91000/graphile_pg.git",
    "directory": "packages/pg-core"
  },
  "keywords": [
    "graphile",
    "postgresql",
    "postgres",
    "pg",
    "adapter",
    "database"
  ],
  "author": "Benjie Gillam <code@benjiegillam.com>",
  "contributors": [
    "Leo Colomb <git@leo.sh>"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/leo91000/graphile_pg/issues"
  },
  "homepage": "https://github.com/leo91000/graphile_pg/tree/main/packages/pg-core#readme",
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/debug": "^4.1.12",
    "@types/node": "^22.15.32",
    "tsdown": "^0.12.9",
    "typescript": "^5.8.3"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20.19"
  }
}
