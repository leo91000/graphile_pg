{
  "name": "@graphile/pg-adapter-pg",
  "version": "0.1.0",
  "description": "PostgreSQL adapter for node-postgres (pg) module",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format cjs,esm",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leo91000/graphile_pg.git",
    "directory": "packages/pg-adapter-pg"
  },
  "keywords": [
    "graphile",
    "postgresql",
    "postgres",
    "pg",
    "adapter",
    "node-postgres"
  ],
  "author": "Benjie Gillam <code@benjiegillam.com>",
  "contributors": [
    "Leo Colomb <git@leo.sh>"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/leo91000/graphile_pg/issues"
  },
  "homepage": "https://github.com/leo91000/graphile_pg/tree/main/packages/pg-adapter-pg#readme",
  "dependencies": {
    "@graphile/pg-core": "workspace:^",
    "@graphile/pg-format": "workspace:^",
    "pg-cursor": "^2.15.3",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "pg": "^8.7.1"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@types/pg": "^8.15.4",
    "pg": "^8.16.3",
    "tsdown": "^0.12.9",
    "typescript": "^5.8.3"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20.19"
  }
}
